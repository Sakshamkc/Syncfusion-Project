{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ExpenseTracker-WATCH",
            "type": "coreclr",
            "request": "launch",
            "program": "dotnet",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/ExpenseTracker/ExpenseTracker.csproj",
                "--launch-profile",
                "http"
            ],
            "cwd": "${workspaceFolder}/ExpenseTracker",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }           
    ]
}
