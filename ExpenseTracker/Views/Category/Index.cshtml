@model IEnumerable<ExpenseTracker.Models.Category>

@{
    ViewData["PageTitle"] = "Categories";
    ViewData["PageActionText"] = "+ New Category";
    ViewData["PageActionUrl"] = "/Category/AddOrEdit";
}

<div class="row">
    <div class="col-12 col-md-7 mb-3 mb-md-0">
        <ejs-grid id="categories" dataSource="@Model" gridLines="None" allowSorting="true" allowPaging="true"
                  clipMode="EllipsisWithTooltip">
            @*<e-grid-pagesettings pageSize="5"></e-grid-pagesettings>*@
            <e-grid-columns>
                <e-grid-column headerText="Category" field="TitleWithIcon" minWidth="100"></e-grid-column>
                <e-grid-column headerText="Type" template="#typeColumnTemplate" minWidth="100"></e-grid-column>
                <e-grid-column headerText="" template="#actionColumnTemplate" width="80"></e-grid-column>
            </e-grid-columns>
        </ejs-grid>
    </div>
    <div class="col-12 col-md-5 hide-mobile">
        <div class="widget h-100 d-flex justify-content-center align-items-center">
            <i class="fa-solid fa-shapes fa-2xl"></i>
        </div>
    </div>
</div>
<script id="typeColumnTemplate" type="text/x-template">
    ${if(Type=="Income")}
    <span class="badge bg-success">${Type}</span>
    ${else}
    <span class="badge bg-danger">${Type}</span>
    ${/if}
    ${if(IsRecurring)}
    <span class="badge bg-info" style="font-size:0.65rem;margin-left:8px;vertical-align:middle;">Recurring</span>
    ${/if}
</script>

<script id="actionColumnTemplate" type="text/x-template">
    <div class="d-flex flex-row justify-content-start">
        <a class="btn btn-sm no-a-decoration" href="/Category/AddOrEdit/${CategoryId}">
            <i class="fa-solid fa-pen fa-lg text-white"></i>
        </a>
        <form action="/Category/Delete/${CategoryId}" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-link no-a-decoration"
                    onclick="return confirm(" Are you sure to delete this record?")">
                <i class="fa-solid fa-trash-can fa-lg text-danger"></i>
            </button>
        </form>
    </div>
</script>