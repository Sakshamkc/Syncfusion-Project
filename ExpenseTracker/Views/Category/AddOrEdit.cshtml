            { emoji: '📊', name: 'analytics report budget' },
            { emoji: '🏘️', name: 'rent housing property' },
        ];

        var grid = document.getElementById('iconPickerGrid');
        var dropdown = document.getElementById('iconPickerDropdown');
        var field = document.getElementById('iconPickerField');
        var hiddenInput = document.getElementById('icon');
        var preview = document.getElementById('iconPreview');
        var placeholder = document.getElementById('iconPlaceholder');
        var searchInput = document.getElementById('iconSearch');

        function renderIcons(filter) {
            grid.innerHTML = '';
            var filtered = filter
                ? icons.filter(function (ic) { return ic.name.indexOf(filter.toLowerCase()) !== -1; })
                : icons;
            filtered.forEach(function (ic) {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'icon-picker-item';
                btn.textContent = ic.emoji;
                btn.title = ic.name;
                btn.addEventListener('click', function () {
                    hiddenInput.value = ic.emoji;
                    preview.textContent = ic.emoji;
                    preview.style.display = '';
                    placeholder.style.display = 'none';
                    dropdown.classList.remove('open');
                });
                grid.appendChild(btn);
            });
        }

        renderIcons('');

        field.addEventListener('click', function (e) {
            dropdown.classList.toggle('open');
            if (dropdown.classList.contains('open')) {
                searchInput.value = '';
                renderIcons('');
                setTimeout(function () { searchInput.focus(); }, 50);
            }
        });

        searchInput.addEventListener('input', function () {
            renderIcons(this.value);
        });

        // Close dropdown on outside click
        document.addEventListener('click', function (e) {
            if (!field.contains(e.target) && !dropdown.contains(e.target)) {
                dropdown.classList.remove('open');
            }
        });
    })();
</script>

