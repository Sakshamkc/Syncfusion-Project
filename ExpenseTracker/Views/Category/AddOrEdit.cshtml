@model ExpenseTracker.Models.Category

@{
    ViewData["PageTitle"] = Model.CategoryId == 0 ? "Create A Category" : "Edit Category";
}

<div class="row">
    <div class="col-12 col-md-7 mb-3 mb-md-0">
        <div class="widget widget-form p-5">
            <form asp-action="AddOrEdit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
                <div class="mb-3">
                    <div class='e-btn-group custom-rbt-group'>
                        @if (Model.Type == "Expense")
                        {
                            <input type="radio" id="radioleft" name="Type" value="Expense" checked />
                        }
                        else
                        {
                            <input type="radio" id="radioleft" name="Type" value="Expense" />
                        }
                        <label class="e-btn" for="radioleft">Expense</label>
                        @if (Model.Type == "Income")
                        {
                            <input type="radio" id="radiomiddle" name="Type" value="Income" checked />
                        }
                        else
                        {
                            <input type="radio" id="radiomiddle" name="Type" value="Income" />
                        }
                        <label class="e-btn" for="radiomiddle">Income</label>
                    </div>
                </div>
                <div class="mb-3">
                    <ejs-textbox id="title" placeholder="Title" ejs-for="Title" floatLabelType="Always"></ejs-textbox>
                    <span asp-validation-for="Title" class="text-danger fs-6"></span>
                </div>
                <div class="mb-3">
                    <label class="icon-picker-label">Icon</label>
                    <input type="hidden" id="icon" name="Icon" value="@Model.Icon" />
                    <div class="icon-picker-field" id="iconPickerField">
                        <span class="icon-picker-preview" id="iconPreview">@(string.IsNullOrEmpty(Model.Icon) ? "" : Model.Icon)</span>
                        <span class="icon-picker-placeholder" id="iconPlaceholder" style="@(string.IsNullOrEmpty(Model.Icon) ? "" : "display:none")">Click to pick an icon</span>
                        <i class="fa-solid fa-chevron-down icon-picker-arrow"></i>
                    </div>
                    <div class="icon-picker-dropdown" id="iconPickerDropdown">
                        <div class="icon-picker-search">
                            <input type="text" id="iconSearch" placeholder="Search icons..." autocomplete="off" />
                        </div>
                        <div class="icon-picker-grid" id="iconPickerGrid"></div>
                    </div>
                </div>
                <div class="mb-3 d-flex align-items-center gap-3">
                    <label class="recurring-toggle" for="isRecurring">
                        <input type="checkbox" id="isRecurring" name="IsRecurring" value="true"
                               @(Model.IsRecurring ? "checked" : "") />
                        <span class="recurring-slider"></span>
                    </label>
                    <label for="isRecurring" class="recurring-label" style="cursor:pointer;">
                        Recurring monthly
                    </label>
                </div>

                <ejs-button id="submit" type="submit" content="Submit" cssClass="e-success"></ejs-button>
            </form>
        </div>

    </div>
    <div class="col-12 col-md-5 hide-mobile">
        <div class="widget h-100 d-flex justify-content-center align-items-center">
            <i class="fa-solid fa-shapes fa-2xl"></i>
        </div>
    </div>
</div>

