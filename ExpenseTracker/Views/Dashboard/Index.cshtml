@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["isDashboard"] = "true";
    var calendarData = (Dictionary<int, int[]>)ViewBag.CalendarData;
    int bsYear = ViewBag.BsYear;
    int bsMonth = ViewBag.BsMonth;
    int bsDay = ViewBag.BsDay;
    string bsMonthName = ViewBag.BsMonthName;
    int daysInMonth = ViewBag.BsDaysInMonth;
    int firstDow = ViewBag.BsFirstDayOfWeek;
}

<div class="row mb-4">
    <div class="col-12 col-md-4 mb-3 mb-md-0">
        <div class="d-flex flex-row widget summary income">
            <div class="d-flex flex-column justify-content-center px-3 py-2">
                <span class="fw-bold" style="font-size:1.25rem">Rs</span>
            </div>
            <div class="d-flex flex-column m-auto py-1">
                <span style="text-align:center;font-size:0.8rem;opacity:0.85">Total Income</span>
                <h1 class="fs-5 fw-bold mb-0">@ViewBag.TotalIncome</h1>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4 mb-3 mb-md-0">
        <div class="d-flex flex-row widget summary expense">
            <div class="d-flex flex-column justify-content-center px-3 py-2">
                <span class="fw-bold" style="font-size:1.25rem">Rs</span>
            </div>
            <div class="d-flex flex-column m-auto py-1">
                <span style="text-align:center;font-size:0.8rem;opacity:0.85">Total Expense</span>
                <h1 class="fs-5 fw-bold mb-0">@ViewBag.TotalExpense</h1>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4 mb-3 mb-md-0">
        <div class="d-flex flex-row widget summary balance">
            <div class="d-flex flex-column justify-content-center px-3 py-2">
                <span class="fw-bold" style="font-size:1.25rem">Rs</span>
            </div>
            <div class="d-flex flex-column m-auto py-1">
                <span style="text-align:center;font-size:0.8rem;opacity:0.85">Total Balance</span>
                <h1 class="fs-5 fw-bold mb-0">@ViewBag.Balance</h1>
            </div>
        </div>
    </div>
    
</div>
<div class="row mb-4">
    <div class="col-12 col-md-6 mb-3 mb-md-0 d-flex">
        <div class="widget nepali-calendar-widget d-flex flex-column w-100">
            <div class="p-4">
                <h5 class="fw-bold" style="text-align:center">
                    <i class="fa-solid fa-calendar-days me-2"></i>Nepali Calendar
                </h5>
            </div>
            <div class="px-4 pb-4 flex-grow-1" id="nepaliCalendarContainer">
                <div class="np-dashboard-cal">
                    <div class="np-dash-header">
                        <button type="button" class="np-cal-nav" id="calPrevMonth" title="Previous month">&laquo;</button>
                        <span class="np-dash-title" id="calMonthTitle">@bsMonthName @bsYear</span>
                        <button type="button" class="np-cal-nav" id="calNextMonth" title="Next month">&raquo;</button>
                    </div>
                    <table class="np-dash-table">
                        <thead>
                            <tr>
                                <th>Sun</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th>
                            </tr>
                        </thead>
                        <tbody id="calBody">
                            @{
                                int dayCounter = 1;
                                bool started = false;
                                for (int row = 0; row < 6 && dayCounter <= daysInMonth; row++)
                                {
                                    <tr>
                                    @for (int col = 0; col < 7; col++)
                                    {
                                        if (!started && col < firstDow)
                                        {
                                            <td></td>
                                        }
                                        else if (dayCounter <= daysInMonth)
                                        {
                                            started = true;
                                            var isToday = (dayCounter == bsDay);
                                            var hasData = calendarData.ContainsKey(dayCounter);
                                            var cellClass = "np-dash-cell";
                                            if (isToday) cellClass += " np-dash-today";
                                            if (hasData) cellClass += " np-dash-has-data";

                                            <td class="@cellClass" data-bsday="@dayCounter" style="cursor:pointer" title="Add transaction for @dayCounter @bsMonthName @bsYear">
                                                <div class="np-dash-day-num">@dayCounter</div>
                                                @if (hasData)
                                                {
                                                    var inc = calendarData[dayCounter][0];
                                                    var exp = calendarData[dayCounter][1];
                                                    if (inc > 0)
                                                    {
                                                        <div class="np-dash-amount income-amt">+@inc.ToString("N0")</div>
                                                    }
                                                    if (exp > 0)
                                                    {
                                                        <div class="np-dash-amount expense-amt">-@exp.ToString("N0")</div>
                                                    }
                                                }
                                            </td>
                                            dayCounter++;
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                    }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    <div class="np-dash-legend mt-3">
                        <span class="np-legend-item"><span class="np-legend-dot income-dot"></span> Income</span>
                        <span class="np-legend-item"><span class="np-legend-dot expense-dot"></span> Expense</span>
                        <span class="np-legend-item"><span class="np-legend-dot today-dot"></span> Today</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 mb-3 mb-md-0 d-flex">
        <div class="widget chart d-flex flex-column w-100">
            <div class="p-4">
                <h5 class="fw-bold" style="text-align:center">Income vs Expense</h5>
            </div>
            <div class="px-4 pb-4 flex-grow-1">
            <ejs-chart id="spline-chart" background="transparent" palettes=@(new string[]{"#54ffa9","#ffe91a"})>
                <e-chart-primaryxaxis valueType="Category">
                    <e-majorgridlines width="0"></e-majorgridlines>
                    <e-majorticklines width="0"></e-majorticklines>
                </e-chart-primaryxaxis>
                <e-chart-primaryyaxis>
                    <e-majorgridlines width="1" color="" dashArray="3,5"></e-majorgridlines>
                    <e-majorticklines width="0"></e-majorticklines>
                    <e-linestyle width="0"></e-linestyle>
                </e-chart-primaryyaxis>
                <e-chart-chartarea>
                    <e-chartarea-border width="0"></e-chartarea-border>
                </e-chart-chartarea>
                <e-series-collection>
                    <e-series dataSource="@ViewBag.SplineChartData" xName="day" yName="income" name="Income" width="3" type="@Syncfusion.EJ2.Charts.ChartSeriesType.Spline"></e-series>
                    <e-series dataSource="@ViewBag.SplineChartData" xName="day" yName="expense" name="Expense" width="3" type="@Syncfusion.EJ2.Charts.ChartSeriesType.Spline"></e-series>
                </e-series-collection>
                <e-chart-legendsettings position="Top" alignment="Far" toggleVisibility="false">
                    <e-legendsettings-textstyle color="" size="1rem"></e-legendsettings-textstyle>
                </e-chart-legendsettings>
                <e-chart-tooltipsettings enable shared></e-chart-tooltipsettings>
            </ejs-chart>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12 col-md-6 mb-3 mb-md-0 d-flex">
        <div class="widget d-flex flex-column w-100">
            <div class="p-4">
                <h5 class="fw-bold" style="text-align:center">Recent Transactions</h5>
            </div>
            <div class="px-4 pb-4 flex-grow-1">
                <ejs-grid id="recent-transactions"
                          dataSource="@ViewBag.RecentTransactions" gridLines="None">
                    <e-grid-columns>
                        <e-grid-column headerText="Category" field="CategoryTitleWithIcon"></e-grid-column>
                        <e-grid-column headerText="Date (BS)" field="NepaliDate" width="130px" textAlign="Left"></e-grid-column>
                        <e-grid-column headerText="Amount" field="FormattedAccount" width="150px" textAlign="Right"></e-grid-column>
                    </e-grid-columns>
                    
                </ejs-grid>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 mb-3 mb-md-0 d-flex">
        <div class="widget chart d-flex flex-column w-100">
            <div class="p-4">
                <h5 class="fw-bold" style="text-align:center">Expense By Category</h5>
            </div>
            <div class="px-4 pb-4 flex-grow-1">
            <ejs-accumulationchart id="doughnutchart" background="transparent">
                <e-accumulation-series-collection>
                    <e-accumulation-series dataSource="@ViewBag.DoughnutChartData"
                                           xName="categoryTitleWithIcon" yName="amount" innerRadius="60%" legendShape="Circle" palettes=@(new string[]{"#0e8d76","#a4b219","#cb9b00","#8a442c","#0454b5","#7d0a0a","#822690","#4c2090","#313e93","#0096ac"})>
                        <e-accumulationseries-datalabel name="formattedAmount" visible></e-accumulationseries-datalabel>
                    </e-accumulation-series>
                </e-accumulation-series-collection>
                <e-accumulationchart-legendsettings position="Top" toggleVisibility="false">
                    <e-legendsettings-textstyle color="" size="1rem"></e-legendsettings-textstyle>
                </e-accumulationchart-legendsettings>
                <e-accumulationchart-tooltipsettings enable></e-accumulationchart-tooltipsettings>
            </ejs-accumulationchart>
            </div>
        </div>
    </div>
</div>

<script src="~/js/nepali-date.js"></script>

<!-- Calendar Event Modal -->
<div id="calEventOverlay" class="cal-event-overlay" style="display:none;">
    <div class="cal-event-modal">
        <div class="cal-event-header">
            <h5 class="mb-0 fw-bold" id="calEventModalTitle">
                <i class="fa-solid fa-calendar-plus me-2"></i><span id="calEventDateLabel"></span>
            </h5>
            <button type="button" class="cal-event-close" id="calEventCloseBtn">&times;</button>
        </div>

        <!-- Existing events for this day -->
        <div id="calEventList" class="cal-event-list"></div>

        <!-- Add new event form -->
        <div class="cal-event-form">
            <div class="cal-event-type-toggle">
                <button type="button" class="cal-type-btn active" data-type="Reminder">
                    <i class="fa-solid fa-bell"></i> Reminder
                </button>
                <button type="button" class="cal-type-btn" data-type="Event">
                    <i class="fa-solid fa-calendar-check"></i> Event
                </button>
            </div>

            <input type="hidden" id="calEventDate" />
            <input type="hidden" id="calEventType" value="Reminder" />

            <div class="mb-2">
                <input type="text" id="calEventTitle" class="cal-event-input" placeholder="Title *" maxlength="100" />
            </div>
            <div class="mb-2">
                <textarea id="calEventDesc" class="cal-event-input" placeholder="Description (optional)" rows="2" maxlength="500"></textarea>
            </div>
            <div id="calEventTimeRow" class="cal-event-time-row" style="display:none;">
                <div>
                    <label class="cal-event-time-label">Start</label>
                    <input type="time" id="calEventStart" class="cal-event-input cal-event-time" />
                </div>
                <div>
                    <label class="cal-event-time-label">End</label>
                    <input type="time" id="calEventEnd" class="cal-event-input cal-event-time" />
                </div>
            </div>
            <div class="cal-event-colors mb-3">
                <button type="button" class="cal-color-btn active" data-color="blue" style="background:#2196f3"></button>
                <button type="button" class="cal-color-btn" data-color="green" style="background:#28a745"></button>
                <button type="button" class="cal-color-btn" data-color="red" style="background:#dc3545"></button>
                <button type="button" class="cal-color-btn" data-color="orange" style="background:#fd7e14"></button>
                <button type="button" class="cal-color-btn" data-color="purple" style="background:#6f42c1"></button>
            </div>
            <button type="button" id="calEventSaveBtn" class="cal-event-save-btn">
                <i class="fa-solid fa-plus me-1"></i> Add
            </button>
        </div>
    </div>
</div>

<script>
    (function () {
        var currentBsYear = @bsYear;
        var currentBsMonth = @bsMonth;
        var todayBsYear = @bsYear;
        var todayBsMonth = @bsMonth;
        var todayBsDay = @bsDay;

        // Event modal elements
        var overlay = document.getElementById('calEventOverlay');
        var closeBtn = document.getElementById('calEventCloseBtn');
        var dateLabel = document.getElementById('calEventDateLabel');
        var eventList = document.getElementById('calEventList');
        var eventDateInput = document.getElementById('calEventDate');
        var eventTypeInput = document.getElementById('calEventType');
        var eventTitle = document.getElementById('calEventTitle');
        var eventDesc = document.getElementById('calEventDesc');
        var eventStart = document.getElementById('calEventStart');
        var eventEnd = document.getElementById('calEventEnd');
        var timeRow = document.getElementById('calEventTimeRow');
        var saveBtn = document.getElementById('calEventSaveBtn');
        var typeBtns = document.querySelectorAll('.cal-type-btn');
        var colorBtns = document.querySelectorAll('.cal-color-btn');
        var selectedColor = 'blue';

        // Type toggle
        typeBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                typeBtns.forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                eventTypeInput.value = btn.getAttribute('data-type');
                timeRow.style.display = btn.getAttribute('data-type') === 'Event' ? 'flex' : 'none';
            });
        });

        // Color picker
        colorBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
                colorBtns.forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                selectedColor = btn.getAttribute('data-color');
            });
        });

        // Close modal
        closeBtn.addEventListener('click', function () { overlay.style.display = 'none'; });
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) overlay.style.display = 'none';
        });

        // Open modal for a specific BS day
        function openEventModal(bsY, bsM, bsDay) {
            var adDate = NepaliDate.bsToAd(bsY, bsM, bsDay);
            var adStr = NepaliDate.formatAd(adDate);
            var bsStr = bsDay + ' ' + NepaliDate.monthNames[bsM - 1] + ' ' + bsY;

            dateLabel.textContent = bsStr;
            eventDateInput.value = adStr;

            // Reset form
            eventTitle.value = '';
            eventDesc.value = '';
            eventStart.value = '';
            eventEnd.value = '';
            eventTypeInput.value = 'Reminder';
            typeBtns.forEach(function (b) { b.classList.remove('active'); });
            typeBtns[0].classList.add('active');
            timeRow.style.display = 'none';
            colorBtns.forEach(function (b) { b.classList.remove('active'); });
            colorBtns[0].classList.add('active');
            selectedColor = 'blue';

            // Load existing events for this day
            loadDayEvents(adStr);

            overlay.style.display = 'flex';
            setTimeout(function () { eventTitle.focus(); }, 200);
        }

        function loadDayEvents(adStr) {
            eventList.innerHTML = '<div style="text-align:center;padding:8px;opacity:0.5;"><i class="fa-solid fa-spinner fa-spin"></i></div>';
            fetch('/CalendarEvent/GetDayEvents?date=' + adStr)
                .then(function (r) { return r.json(); })
                .then(function (events) {
                    if (!events.length) {
                        eventList.innerHTML = '<div class="cal-event-empty"><i class="fa-regular fa-calendar-xmark me-1"></i> No events for this day</div>';
                        return;
                    }
                    var html = '';
                    events.forEach(function (ev) {
                        var icon = ev.type === 'Event' ? 'fa-calendar-check' : 'fa-bell';
                        var timeStr = '';
                        if (ev.startTime) {
                            timeStr = '<span class="cal-ev-time"><i class="fa-regular fa-clock me-1"></i>' + ev.startTime;
                            if (ev.endTime) timeStr += ' - ' + ev.endTime;
                            timeStr += '</span>';
                        }
                        html += '<div class="cal-ev-item" data-id="' + ev.eventId + '">' +
                            '<div class="cal-ev-color-bar" style="background:' + getColorHex(ev.color) + '"></div>' +
                            '<div class="cal-ev-content">' +
                                '<div class="cal-ev-title"><i class="fa-solid ' + icon + ' me-1"></i>' + escapeHtml(ev.title) + '</div>' +
                                (ev.description ? '<div class="cal-ev-desc">' + escapeHtml(ev.description) + '</div>' : '') +
                                timeStr +
                            '</div>' +
                            '<button class="cal-ev-delete" title="Delete" data-id="' + ev.eventId + '"><i class="fa-solid fa-trash-can"></i></button>' +
                        '</div>';
                    });
                    eventList.innerHTML = html;

                    // Delete buttons
                    eventList.querySelectorAll('.cal-ev-delete').forEach(function (btn) {
                        btn.addEventListener('click', function (e) {
                            e.stopPropagation();
                            var id = btn.getAttribute('data-id');
                            deleteEvent(id, adStr);
                        });
                    });
                })
                .catch(function () {
                    eventList.innerHTML = '<div class="cal-event-empty">Failed to load events</div>';
                });
        }

        function deleteEvent(id, adStr) {
            fetch('/CalendarEvent/Delete?id=' + id, { method: 'POST', credentials: 'same-origin' })
                .then(function () {
                    loadDayEvents(adStr);
                    // Refresh calendar to update dots
                    loadCalendarMonth(currentBsYear, currentBsMonth);
                });
        }

        // Save event
        saveBtn.addEventListener('click', function () {
            var title = eventTitle.value.trim();
            if (!title) { eventTitle.focus(); eventTitle.style.borderColor = '#dc3545'; return; }
            eventTitle.style.borderColor = '';

            var body = {
                title: title,
                description: eventDesc.value.trim() || null,
                type: eventTypeInput.value,
                date: eventDateInput.value,
                startTime: eventStart.value || null,
                endTime: eventEnd.value || null,
                color: selectedColor
            };

            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin me-1"></i> Saving...';

            fetch('/CalendarEvent/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify(body)
            })
            .then(function (r) { return r.json(); })
            .then(function () {
                // Reset form
                eventTitle.value = '';
                eventDesc.value = '';
                eventStart.value = '';
                eventEnd.value = '';
                // Reload day events
                loadDayEvents(eventDateInput.value);
                // Refresh calendar dots
                loadCalendarMonth(currentBsYear, currentBsMonth);
            })
            .catch(function () { alert('Failed to save'); })
            .finally(function () {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="fa-solid fa-plus me-1"></i> Add';
            });
        });

        function getColorHex(c) {
            var map = { blue: '#2196f3', green: '#28a745', red: '#dc3545', orange: '#fd7e14', purple: '#6f42c1' };
            return map[c] || map.blue;
        }

        function escapeHtml(str) {
            var div = document.createElement('div');
            div.textContent = str;
            return div.innerHTML;
        }

        // Calendar click handlers — open event modal
        function attachCalendarClickHandlers(bsY, bsM) {
            var cells = document.querySelectorAll('#calBody td[data-bsday]');
            cells.forEach(function (cell) {
                cell.addEventListener('click', function () {
                    var day = parseInt(this.getAttribute('data-bsday'));
                    openEventModal(bsY, bsM, day);
                });
            });
        }

        // Initial attachment
        attachCalendarClickHandlers(currentBsYear, currentBsMonth);

        document.getElementById('calPrevMonth').addEventListener('click', function (e) {
            e.preventDefault();
            currentBsMonth--;
            if (currentBsMonth < 1) { currentBsMonth = 12; currentBsYear--; }
            loadCalendarMonth(currentBsYear, currentBsMonth);
        });

        document.getElementById('calNextMonth').addEventListener('click', function (e) {
            e.preventDefault();
            currentBsMonth++;
            if (currentBsMonth > 12) { currentBsMonth = 1; currentBsYear++; }
            loadCalendarMonth(currentBsYear, currentBsMonth);
        });

        function loadCalendarMonth(bsY, bsM) {
            fetch('/Dashboard/CalendarData?bsYear=' + bsY + '&bsMonth=' + bsM)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    renderCalendar(bsY, bsM, data);
                })
                .catch(function () {
                    renderCalendar(bsY, bsM, { daysInMonth: 30, firstDow: 0, transactions: {} });
                });
        }

        function renderCalendar(bsY, bsM, data) {
            document.getElementById('calMonthTitle').textContent =
                NepaliDate.monthNames[bsM - 1] + ' ' + bsY;

            var daysInMonth = data.daysInMonth;
            var firstDow = data.firstDow;
            var txns = data.transactions || {};
            var evts = data.events || {};

            var html = '';
            var dayCounter = 1;
            var started = false;
            for (var row = 0; row < 6 && dayCounter <= daysInMonth; row++) {
                html += '<tr>';
                for (var col = 0; col < 7; col++) {
                    if (!started && col < firstDow) {
                        html += '<td></td>';
                    } else if (dayCounter <= daysInMonth) {
                        started = true;
                        var isToday = (bsY === todayBsYear && bsM === todayBsMonth && dayCounter === todayBsDay);
                        var dayData = txns[dayCounter.toString()];
                        var dayEvents = evts[dayCounter.toString()];
                        var cls = 'np-dash-cell';
                        if (isToday) cls += ' np-dash-today';
                        if (dayData) cls += ' np-dash-has-data';

                        html += '<td class="' + cls + '" data-bsday="' + dayCounter + '" style="cursor:pointer" title="Click to add event/reminder">';
                        html += '<div class="np-dash-day-num">' + dayCounter + '</div>';
                        if (dayData) {
                            if (dayData.income > 0)
                                html += '<div class="np-dash-amount income-amt">+' + dayData.income.toLocaleString() + '</div>';
                            if (dayData.expense > 0)
                                html += '<div class="np-dash-amount expense-amt">-' + dayData.expense.toLocaleString() + '</div>';
                        }
                        // Event dots
                        if (dayEvents && dayEvents.length) {
                            html += '<div class="np-event-dots">';
                            dayEvents.forEach(function (ev) {
                                html += '<span class="np-event-dot" style="background:' + getColorHex(ev.color) + '" title="' + escapeHtml(ev.title) + '"></span>';
                            });
                            html += '</div>';
                        }
                        html += '</td>';
                        dayCounter++;
                    } else {
                        html += '<td></td>';
                    }
                }
                html += '</tr>';
            }
            document.getElementById('calBody').innerHTML = html;
            attachCalendarClickHandlers(bsY, bsM);
        }
    })();
</script>