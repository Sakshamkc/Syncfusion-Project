<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ExpenseTracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @*<link rel="stylesheet" href="https://cdn.syncfusion.com/ej2/20.3.47/material.css" />*@
    <link href="https://cdn.syncfusion.com/ej2/20.3.47/bootstrap5-dark.css" rel="stylesheet" id="sf-theme-css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="~/js/theme.js"></script>
</head>
<body class="e-bigger">
    @inject SignInManager<IdentityUser> SignInManager
    @inject UserManager<IdentityUser> UserManager

    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <partial name="_sidebar" />
    <div class="dock-target">
        <nav class="navbar sticky-top">
            <div class="container-fluid py-2 px-4">
                <div class="d-flex align-items-center gap-2">
                    <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle menu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <i class="fa-solid fa-magnifying-glass"></i>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <button id="themeToggleBtn" class="theme-toggle-btn" aria-label="Toggle theme">
                        <i id="themeToggleIcon" class="fa-solid fa-sun"></i>
                    </button>
                    <i class="fa-solid fa-bell"></i>
                    <i class="fa-solid fa-message"></i>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown">
                            <a class="btn btn-outline-light btn-sm dropdown-toggle d-flex align-items-center gap-2"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">
                                <img class="profile-pic" src="~/profile.jpg" alt="Profile"
                                     style="width:32px;height:32px;border-radius:999px;object-fit:cover;" />
                                <span class="d-none d-md-inline">@User.Identity?.Name</span>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li>
                                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">
                                        <i class="fa-solid fa-user-gear me-2"></i>Account
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form class="px-2" asp-area="Identity" asp-page="/Account/Logout" method="post">
                                        <button type="submit" class="btn btn-danger w-100">
                                            <i class="fa-solid fa-right-from-bracket me-2"></i>Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }                    
                </div>
            </div>
        </nav>


        <div class="main-content">
            <div class="container-fluid mt-3 mt-md-5 px-3 px-md-4">
                <div class="row justify-content-center">
                    <div class="@(ViewData["isDashboard"] == null?"col-12 col-md-10":"col-12")">
                        <main role="main" class="pb-3">
                            @if (ViewData["isDashboard"] == null)
                            {
                                <div class="row">
                                    <div class="col-12 col-md-7">
                                        <div class="d-flex flex-column mb-3 mb-md-5">
                                            <div class="d-flex mb-1">
                                                <div class="flex-grow-1">
                                                    <h3 class="fw-bold">@ViewData["PageTitle"]</h3>
                                                </div>
                                                <div>
                                                    @if (@ViewData["PageActionText"] != null)
                                                    {
                                                        <a class="btn btn-success" href="@ViewData["PageActionUrl"]">
                                                            @ViewData["PageActionText"]
                                                        </a>
                                                    }

                                                </div>
                                            </div>
                                            <ejs-breadcrumb id="breadcrumb"
                                                            separatorTemplate="@Html.Raw("<span class='fa-solid fa-angle-right'></span>")"></ejs-breadcrumb>
                                        </div>
                                    </div>
                                </div>
                            }
                            @RenderBody()
                        </main>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.syncfusion.com/ej2/20.3.47/dist/ej2.min.js"></script>
    <ejs-scripts></ejs-scripts>
    <script>
        // Mobile sidebar toggle
        document.addEventListener('DOMContentLoaded', function () {
            var toggleBtn = document.getElementById('mobileMenuToggle');
            var sidebar = document.getElementById('sidebar');
            var overlay = document.getElementById('sidebarOverlay');
            var dockTarget = document.querySelector('.dock-target');

            function isMobile() {
                return window.innerWidth <= 991;
            }

            // On mobile: disable Syncfusion dock behavior, reset dock target margins
            function handleMobileSetup() {
                if (isMobile() && sidebar) {
                    // Disable dock so Syncfusion stops injecting margin-left
                    if (sidebar.ej2_instances && sidebar.ej2_instances[0]) {
                        var sidebarObj = sidebar.ej2_instances[0];
                        sidebarObj.enableDock = false;
                        sidebarObj.type = 'Over';
                    }
                    // Make sure sidebar is NOT display:none or visibility:hidden
                    sidebar.style.visibility = 'visible';
                    sidebar.style.display = 'block';
                    // Remove mobile-open so it starts closed
                    sidebar.classList.remove('mobile-open');
                    overlay.classList.remove('active');
                    // Reset dock target
                    if (dockTarget) {
                        dockTarget.style.marginLeft = '0px';
                        dockTarget.style.width = '100%';
                    }
                }
            }

            handleMobileSetup();

            // MutationObserver: Syncfusion may re-apply inline styles
            if (dockTarget) {
                var observer = new MutationObserver(function () {
                    if (isMobile()) {
                        if (dockTarget.style.marginLeft !== '0px') {
                            dockTarget.style.marginLeft = '0px';
                            dockTarget.style.width = '100%';
                        }
                    }
                });
                observer.observe(dockTarget, { attributes: true, attributeFilter: ['style'] });
            }

            // Watch sidebar for Syncfusion resetting visibility
            if (sidebar) {
                var sidebarObserver = new MutationObserver(function () {
                    if (isMobile()) {
                        if (sidebar.style.visibility === 'hidden') {
                            sidebar.style.visibility = 'visible';
                        }
                        if (sidebar.style.display === 'none') {
                            sidebar.style.display = 'block';
                        }
                    }
                });
                sidebarObserver.observe(sidebar, { attributes: true, attributeFilter: ['style'] });
            }

            // Resize handler
            var resizeTimer;
            window.addEventListener('resize', function () {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(function () {
                    if (isMobile()) {
                        handleMobileSetup();
                    } else {
                        // Restore desktop sidebar dock behavior
                        if (sidebar && sidebar.ej2_instances && sidebar.ej2_instances[0]) {
                            var sidebarObj = sidebar.ej2_instances[0];
                            sidebarObj.enableDock = true;
                            sidebarObj.type = 'Push';
                            sidebarObj.show();
                        }
                    }
                }, 150);
            });

            // Hamburger button click
            if (toggleBtn && sidebar && overlay) {
                toggleBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var isOpen = sidebar.classList.contains('mobile-open');
                    if (isOpen) {
                        sidebar.classList.remove('mobile-open');
                        overlay.classList.remove('active');
                    } else {
                        // Ensure sidebar is visible before opening
                        sidebar.style.visibility = 'visible';
                        sidebar.style.display = 'block';
                        sidebar.classList.add('mobile-open');
                        overlay.classList.add('active');
                    }
                    // Keep dock target margin at 0
                    if (dockTarget) {
                        dockTarget.style.marginLeft = '0px';
                    }
                });

                overlay.addEventListener('click', function () {
                    sidebar.classList.remove('mobile-open');
                    overlay.classList.remove('active');
                });
            }
        });
    </script>
    <script src="~/js/idle-timeout.js"></script>
</body>
</html>
